{
  "name": "viewer",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "dotenv -e ./.env -e ../../.env  -- next dev -p 3001",
    "build": "dotenv -e ./.env -e ../../.env -- next build",
    "build:analyze": "dotenv -e ./.env -e ../../.env -- ANALYZE=true next build",
    "start": "dotenv -e ./.env -e ../../.env -- next start -p 3001",
    "lint": "dotenv -e ./.env -e ../../.env -- next lint",
    "format:write": "prettier --write ./src --ignore-path ../../.prettierignore",
    "format:check": "prettier --check ./src --ignore-path ../../.prettierignore",
    "test": "dotenv -e ./.env -e ../../.env -- bun run playwright test",
    "test:dev": "dotenv -e ./.env -e ../../.env -- bun run playwright test --max-failures=1;",
    "test:ui": "dotenv -e ./.env -e ../../.env -- bun run playwright test --ui;",
    "test:report": "bun run playwright show-report ../../tests/viewer-html-report;",
    "test:backup": "node ../../scripts/version-control-test.js",
    "db:migrate:deploy": "cd ../../packages/prisma && bun run prisma:migrate:deploy",
    "openapi:generate": "dotenv -e ./.env -e ../../.env -- tsx src/helpers/server/generateOpenApi.ts",
    "prebuild": "bun run openapi:generate"
  },
  "dependencies": {
    "@lilyrose2798/trpc-openapi": "^1.3.9",
    "@planetscale/database": "1.8.0",
    "@sentry/nextjs": "^9.6.1",
    "@sentry/node": "^9.6.1",
    "@sentry/tracing": "^7.120.3",
    "@trpc/server": "10.40.0",
    "@quickbot.io/bot-engine": "workspace:*",
    "@quickbot.io/prisma": "workspace:*",
    "@urbiport/icons": "workspace:*",
    "@urbiport/nextjs": "workspace:*",
    "cors": "2.8.5",
    "google-spreadsheet": "4.1.1",
    "isolated-vm": "5.0.1",
    "next": "14.2.26",
    "nextjs-cors": "2.1.2",
    "nodemailer": "6.9.8",
    "openai": "4.47.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "stripe": "12.13.0",
    "phone": "^3.1.59",
    "superjson": "1.12.4"
  },
  "devDependencies": {
    "@faire/mjml-react": "3.3.0",
    "@playwright/test": "1.45.2",
    "@quickbot.io/emails": "workspace:*",
    "@quickbot.io/env": "workspace:*",
    "@quickbot.io/forge": "workspace:*",
    "@quickbot.io/forge-repository": "workspace:*",
    "@quickbot.io/lib": "workspace:*",
    "@quickbot.io/playwright": "workspace:*",
    "@quickbot.io/results": "workspace:*",
    "@quickbot.io/schemas": "workspace:*",
    "@quickbot.io/tsconfig": "workspace:*",
    "@quickbot.io/variables": "workspace:*",
    "@types/cors": "2.8.13",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "6.4.14",
    "@types/papaparse": "5.3.7",
    "@types/react": "18.2.15",
    "autoprefixer": "^10.4.20",
    "dotenv": "16.4.5",
    "dotenv-cli": "7.4.1",
    "eslint-config-custom": "workspace:*",
    "google-auth-library": "8.9.0",
    "papaparse": "5.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "5.4.5",
    "zod": "3.22.4"
  }
}
