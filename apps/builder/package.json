  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "dotenv -e ./.env -e ../../.env -- next dev -p 3000",
    "build": "dotenv -e ./.env -e ../../.env -- next build",
    "start": "dotenv -e ./.env -e ../../.env -- next start -p 3000",
    "lint": "dotenv -e ./.env -e ../../.env -- next lint",
    "test": "dotenv -e ./.env -e ../../.env -- bun playwright test",
    "test:ui": "dotenv -e ./.env -e ../../.env -- bun playwright test --ui",
    "format:write": "prettier --write ./src --ignore-path ../../.prettierignore",
    "format:check": "prettier --check ./src --ignore-path ../../.prettierignore",
    "db:migrate:deploy": "cd ../../packages/prisma && bun run prisma:migrate:deploy",
    "openapi:generate": "dotenv -e ./.env -e ../../.env -- tsx src/helpers/server/generateOpenApi.ts",
    "prebuild": "bun run openapi:generate"
  },
