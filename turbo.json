{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["DATABASE_URL", "DATABASE_DIRECT_URL", "SKIP_ENV_CHECK"],
  "globalPassThroughEnv": ["ENCRYPTION_SECRET"],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "format:write": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^prisma:generate", "@urbiport/ui#build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "env": ["VERCEL_*", "NEXTAUTH_URL", "SENTRY_*", "LANDING_PAGE_URL"],
      "dependsOn": ["^build", "^prisma:generate"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "public/__ENV.js",
        ".vercel"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "outputLogs": "new-only"
    },
    "@urbiport/ui#build": {
      "dependsOn": ["@urbiport/icons#build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@urbiport/icons#build": {
      "dependsOn": [],
      "outputs": ["dist/**", "build/**"]
    },
    "@quickbot.io/emails#build": {
      "env": ["NEXTAUTH_URL", "SENTRY_AUTH_TOKEN", "SENTRY_PROJECT", "SENTRY_ORG"],
      "outputs": []
    },
    "docs#build": {
      "dependsOn": ["builder#build", "viewer#build"],
      "outputLogs": "new-only"
    },
    "prisma:generate": {
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"],
      "cache": false
    },
    "prisma:migrate:deploy": {
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"],
      "cache": false
    },
    "checkAndReportChatsUsage": {
      "env": ["STRIPE_*", "NEXTAUTH_URL", "SMTP_*"],
      "dependsOn": ["prisma:generate"],
      "cache": false
    }
  }
}
